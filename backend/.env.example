# ── Database ──────────────────────────────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=localhost;Database=financialcopilot;Username=postgres;Password=CHANGE_ME

# ── JWT ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
Jwt__Key=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET
Jwt__Issuer=FinancialCopilot
Jwt__Audience=FinancialCopilotUsers

# ── AI Engine ─────────────────────────────────────────────────────────────
AiEngine__Url=http://localhost:8001

# ── Email (optional) ──────────────────────────────────────────────────────
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUser=your-email@gmail.com
Email__SmtpPassword=your-app-password
Email__FromName=FINNOVA
Email__FromEmail=your-email@gmail.com

# ── Admin bootstrap (optional) ────────────────────────────────────────────
AdminBootstrap__Email=admin@yourdomain.com
AdminBootstrap__Password=CHANGE_ME_STRONG_PASSWORD

# ── CORS ──────────────────────────────────────────────────────────────────
AllowedOrigins=http://localhost:3000,https://yourdomain.com

# ── Wompi (pagos Colombia) ────────────────────────────────────────────────
# Obtén tus llaves en https://comercios.wompi.co
Wompi__PublicKey=pub_test_XXXXXXXXXXXXXXXXXXXXXXXX
Wompi__PrivateKey=prv_test_XXXXXXXXXXXXXXXXXXXXXXXX
Wompi__RedirectUrl=https://yourdomain.com/dashboard
